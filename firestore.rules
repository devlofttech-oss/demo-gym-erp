rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function userDocExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userDocData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return isSignedIn() && userDocExists() && userDocData().role == 'superadmin';
    }

    function isAdminOf(gymId) {
      return isSignedIn() && userDocExists()
        && userDocData().role == 'admin'
        && (
          userDocData().gymId == gymId ||
          ('gymIds' in userDocData() && gymId in userDocData().gymIds)
        );
    }

    function isStaffOf(gymId) {
      return isSignedIn() && userDocExists()
        && userDocData().role == 'staff'
        && userDocData().gymId == gymId;
    }

    // ── Users collection ─────────────────────────────────────────
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());

      // Public trial registration creates the gym owner user doc
      allow create: if !isSignedIn()
        && request.resource.data.role == 'admin'
        && request.resource.data.email is string;

      allow create: if isSignedIn() && request.auth.uid == userId;

      // Superadmin creates gym owner accounts (secondary app pattern)
      allow create: if isSuperAdmin();

      // Admin creates staff accounts for their own gym (secondary app pattern)
      allow create: if isSignedIn() && userDocExists()
        && userDocData().role == 'admin'
        && request.resource.data.gymId == userDocData().gymId
        && request.resource.data.role == 'staff';

      // User updates their own doc; superadmin updates anyone;
      // admin updates their gym's staff
      allow update: if isSignedIn() && (
        request.auth.uid == userId ||
        isSuperAdmin() ||
        (userDocExists()
          && userDocData().role == 'admin'
          && resource.data.gymId == userDocData().gymId
          && resource.data.role == 'staff')
      );

      // Superadmin deletes anyone; admin deletes their gym's staff
      allow delete: if isSuperAdmin() || (
        isSignedIn() && userDocExists()
        && userDocData().role == 'admin'
        && resource.data.gymId == userDocData().gymId
        && resource.data.role == 'staff'
      );
    }

    // ── Gym metadata (root gyms collection) ──────────────────────
    match /gyms/{gymId} {
      allow read: if isSignedIn() && (
        isSuperAdmin() || isAdminOf(gymId) || isStaffOf(gymId)
      );

      allow write: if isSuperAdmin();

      // Public trial registration — must be a trial plan with required fields
      allow create: if !isSignedIn()
        && request.resource.data.planName == 'Trial'
        && request.resource.data.isActive == true
        && request.resource.data.ownerEmail is string;

      allow create: if isSignedIn() && userDocExists()
        && userDocData().role == 'admin'
        && request.resource.data.ownerUid == request.auth.uid;

      allow update: if isAdminOf(gymId);
    }

    // ── Subscription plan templates (superadmin CRUD, admins read) ─
    match /subscriptionPlans/{planId} {
      allow read: if true; // public — register page needs to read trial plan without auth
      allow write: if isSuperAdmin();
    }

    // ── Trial sign-up requests ────────────────────────────────────
    match /trialRequests/{reqId} {
      allow create: if true;
      allow read, update, delete: if isSuperAdmin();
    }

    // ── Gym tenant data ───────────────────────────────────────────
    match /gyms/{gymId}/{collection}/{docId} {
      // Public trial registration seeds the gym settings doc
      allow create: if !isSignedIn() && collection == 'settings' && docId == 'general';

      // Superadmin and gym admin: full access
      allow read, write: if isSuperAdmin() || isAdminOf(gymId);

      // Staff: read members/staff/attendance (check-in lookup) + measurements
      allow read: if isStaffOf(gymId) && collection in ['members', 'staff', 'attendance', 'staffAttendance', 'measurements'];

      // Staff: write member + staff attendance; manage measurements; update members (lastCheckin)
      allow create: if isStaffOf(gymId) && collection in ['attendance', 'staffAttendance', 'measurements'];
      allow update: if isStaffOf(gymId) && collection in ['attendance', 'staffAttendance', 'members', 'measurements'];
      allow delete: if isStaffOf(gymId) && collection == 'measurements';
    }
  }
}
